import tkinter as tk
from tkinter import ttk, messagebox
import serial
import time
import threading

 #arduino

PORT = "COM3"
BAUD = 115200

NUM_ACTUATORS = 3

try:
    arduino = serial.Serial(
        PORT,
        BAUD,
        timeout=1
    )

    time.sleep(2)

    print("Connected to Arduino")

except Exception as e:
    arduino = None
    print("Arduino not connected:")
    print(e)

#printing conection

def send_command(command):

    if arduino is None:
        print("Arduino not connected")
        return

    try:
        arduino.write(
            (command + "\n").encode()
        )

        print("Sent:", command)

    except Exception as e:
        print("Serial error:", e)


#actuator settings for GUI

def move_actuator(actuator, direction):

    try:
        milliseconds = int(
            time_entries[actuator].get()
        )

    except ValueError:
        messagebox.showerror(
            "Invalid Time",
            "Enter a whole number."
        )
        return

    if milliseconds <= 0:
        messagebox.showerror(
            "Invalid Time",
            "Time must be greater than 0."
        )
        return

    command = (
        f"MOVE,{actuator},{direction},{milliseconds}"
    )

    send_command(command)


#adding multiple actions

actions = []


def add_action():

    try:
        actuator = int(
            actuator_selector.get()
        )

        direction = direction_selector.get()

        milliseconds = int(
            action_time.get()
        )

    except ValueError:
        messagebox.showerror(
            "Invalid Action",
            "Please enter a valid actuator and time."
        )
        return


    if milliseconds <= 0:
        messagebox.showerror(
            "Invalid Time",
            "Time must be greater than 0."
        )
        return


    action = {
        "actuator": actuator,
        "direction": direction,
        "time": milliseconds
    }

    actions.append(action)

    update_action_list()


#removing an action

def remove_action():

    selected = action_list.curselection()

    if not selected:
        return

    index = selected[0]

    actions.pop(index)

    update_action_list()

#removing all actions

def clear_actions():

    actions.clear()

    update_action_list()


#updating the action list

def update_action_list():

    action_list.delete(
        0,
        tk.END
    )

    for i, action in enumerate(actions):

        actuator = action["actuator"] + 1

        direction = action["direction"]

        milliseconds = action["time"]

        if direction == "U":
            direction_text = "UP"
        else:
            direction_text = "DOWN"

        text = (
            f"{i + 1}.  "
            f"Actuator {actuator}  |  "
            f"{direction_text}  |  "
            f"{milliseconds} ms"
        )

        action_list.insert(
            tk.END,
            text
        )


#sending series to actuators

def send_sequence():

    if len(actions) == 0:

        messagebox.showwarning(
            "Empty Sequence",
            "Add at least one action first."
        )

        return


    if arduino is None:

        messagebox.showerror(
            "Arduino",
            "Arduino is not connected."
        )

        return


    #ran in a separate thread so the GUI doesn't freeze

    threading.Thread(
        target=run_sequence,
        daemon=True
    ).start()


def run_sequence():

    status.config(
        text="Running sequence..."
    )


    for action in actions:

        actuator = action["actuator"]

        direction = action["direction"]

        milliseconds = action["time"]


        command = (
            f"MOVE,{actuator},{direction},{milliseconds}"
        )


        send_command(command)


#Wait for this action to finish before sending anything else
        
        time.sleep(
            milliseconds / 1000.0
        )

#funky break beteewn actions

        time.sleep(0.05)


    status.config(
        text="Sequence complete"
    )


#BIG QUIT IF THINGS GO WRONG

def stop_all():

    send_command("STOP")

    status.config(
        text="STOPPED"
    )

def close_program():

    send_command("STOP")

    if arduino is not None:
        arduino.close()

    root.destroy()


